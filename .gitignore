logs/
results/
eval_outputs/
wandb/

# Data and weights are distributed separately (see the links in README.md).
# These are machine-local directories or symlinks; committing them would either
# bloat the repo or leak absolute paths from whichever machine created them.
datasets/
checkpoints/
pretrained/

